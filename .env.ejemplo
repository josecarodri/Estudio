# Copia este archivo como ".env" (en la carpeta estudio) y rellena lo que necesites.

# --- Servidor TURN (recomendado para llamadas entre ciudades / redes distintas) ---
# Opción A: Cloudflare Realtime TURN (1000 GB/mes gratis). En dash.cloudflare.com → Realtime → TURN Server
# crea una clave y copia aquí su "Turn Token ID" y su "API Token".
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Opción B: cualquier otro servidor TURN (coturn propio, Metered, Twilio…)
TURN_URL=
TURN_USER=
TURN_PASS=

# --- Enlace público ---
# cloudflare (por defecto): enlace nuevo cada vez, sin cuenta.
# tailscale: enlace fijo https://<tu-pc>.<tu-red>.ts.net (requiere Tailscale instalado y con sesión iniciada).
# PUBLICO=tailscale

# Clave secreta que llevan los enlaces de invitación (?k=...). Se genera sola la primera vez.
# Cámbiala (o bórrala para generar otra) si quieres que dejen de funcionar los enlaces que ya enviaste.
# CLAVE_ACCESO=

# --- Otros ---
# PORT=8080
# HTTPS_PORT=8443
# GRABACIONES_DIR=C:\Users\yo\Videos\Estudio
